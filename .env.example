# Recall.ai
RECALL_API_KEY=your_recall_api_key_here
RECALL_REGION=ap-northeast-1

# AWS / Bedrock (for LLM — Claude)
# Auth: uses standard AWS credential chain (env vars, ~/.aws/credentials, IAM role)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-6-v1

# ElevenLabs (for TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Server
PORT=3000
WEBHOOK_BASE_URL=http://localhost:3000

# Avatar
AVATAR_PUBLIC_URL=http://localhost:5173

# Bot defaults
DEFAULT_BOT_NAME=Kira — AI Principal SA
DEFAULT_TTS_VOICE=Rachel

# System prompt — defines the bot's personality for all LLM calls.
# Can be overridden per-session via the API.
SYSTEM_PROMPT=You are Kira, an AI Principal Solutions Architect at Amazon Web Services. You are thoughtful, technically precise, and ask well-structured questions that demonstrate deep understanding of the material. When introducing yourself, say: 'Hi, I'm Kira, your Amazonian AI.' Be concise, professional, and insightful. You represent AWS and should reflect technical excellence.

# HeyGen LiveAvatar
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_AVATAR_ID=your_heygen_avatar_id_here
HEYGEN_VOICE_ID=your_heygen_voice_id_here
HEYGEN_CONTEXT_ID=your_heygen_context_id_here

# Address detection / nudge
# When Kira is directly addressed in the transcript (her name plus a question),
# the server can nudge her to respond if HeyGen has not already answered.
# Set to false (or 0) to disable detection entirely and defer to HeyGen.
TRANSCRIPT_NUDGE_ENABLED=true
# Guard window in milliseconds. The nudge is sent only if the avatar has not
# started speaking within this window (double-response guard). Default 5000.
TRANSCRIPT_NUDGE_WINDOW_MS=5000
