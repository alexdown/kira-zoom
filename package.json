{
  "name": "ai-meeting-bot",
  "version": "0.1.0",
  "description": "AI bot that joins Zoom meetings via Recall.ai, reads papers, raises hand during Q&A, and asks intelligent questions aloud.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "@aws-sdk/client-bedrock-runtime": "^3.730.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.12.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
